{
  "manifest_version": "1.0.0",
  "project": {
    "name": "qudor-ai",
    "version": "2.0.0",
    "description": "AlphaZero-style AI for 9x9 Quoridor with bitboard engine, MCTS/Gumbel search, and web viewer"
  },
  "environments": {
    "local_development": {
      "os": "Windows 11 x86_64",
      "python": "3.14.3",
      "torch": "2.11.0+cpu",
      "numpy": "2.4.6",
      "pytest": "9.1.1",
      "ruff": "0.16.3",
      "requirements_file": "requirements-lock.txt"
    },
    "gpu_server_training": {
      "os": "Ubuntu 22.04 x86_64",
      "python": "3.10.x",
      "gpu": "NVIDIA GeForce RTX 3060 Ti 8GB",
      "driver": ">=550.142",
      "cuda": "12.4",
      "torch": "2.5.1+cu124",
      "numpy": "1.26.4",
      "pytest": "8.3.4",
      "ruff": "0.8.4",
      "requirements_file": "requirements-server-cuda.txt"
    }
  },
  "verification_commands": [
    "python -m compileall -q app.py train.py quoridor_ai tests tools bench scripts",
    "python -m ruff check . --select F,E9,B",
    "python -m pytest -m \"not integration\" -q",
    "python -m pytest -q"
  ],
  "project_dependencies": {
    "local": {
      "numpy": "2.4.6",
      "torch": "2.11.0+cpu",
      "pytest": "9.1.1",
      "ruff": "0.16.3",
      "setuptools": "81.0.0"
    },
    "gpu_server": {
      "numpy": "1.26.4",
      "torch": "2.5.1+cu124",
      "pytest": "8.3.4",
      "ruff": "0.8.4",
      "setuptools": ">=70.0.0"
    }
  }
}
